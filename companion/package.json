{
  "name": "internops-companion",
  "productName": "InternOps Companion",
  "version": "1.3.0",
  "description": "Desktop companion for InternOps Work Mode — tracks high-level application activity only while explicitly enabled, and produces a factual shift report at the end of each session.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win zip --x64 --publish never",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.internops.companion",
    "productName": "InternOps Companion",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "InternOps.Companion-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "InternOps Companion"
    },
    "win": {
      "artifactName": "InternOps.Companion-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "karimmoh1-glitch",
      "repo": "internops-refined",
      "vPrefixedTagName": false,
      "channel": "latest"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
