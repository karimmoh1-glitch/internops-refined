# Copy this file to .env for local development and fill in real values.
# Never commit .env — it's already in .gitignore.
#
# In production, set these as real environment variables on your hosting
# platform (Railway/Render/Fly/Vercel/etc.) instead of shipping a .env file.

# --- Core (required) ---

NODE_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/internops

# Secret used to sign JWT auth tokens. Generate a real random value for any
# non-local environment, e.g.: openssl rand -hex 32
# The app refuses to start in production if this isn't set — see
# server/routes.ts — rather than silently falling back to an insecure
# default that would let anyone forge valid auth tokens.
JWT_SECRET=

# Public base URL of this deployment. Used to build links in emails
# (invites, password resets, application notifications) and the
# OpenGraph/Twitter image meta tags. No trailing slash.
APP_URL=http://localhost:3001

# --- Email (optional in development) ---
#
# Without RESEND_API_KEY, emails are logged to the console instead of sent
# ("[MOCK EMAIL]") — the app still works fully in development, nothing
# fails. Set this to actually send email.

RESEND_API_KEY=

# Sender identity for outgoing email. Should be a verified domain you
# control once you leave development — see the domain/DNS section in
# README.md for SPF/DKIM/DMARC setup.
EMAIL_FROM="InternOps <noreply@APP_DOMAIN>"

# Comma-separated list of addresses that get notified (in addition to a
# company's own admin users) whenever a new application comes in on any
# company's public application page. Optional — leave unset to disable.
# Example: ADMIN_NOTIFICATION_EMAILS=you@yourcompany.com,cofounder@yourcompany.com
ADMIN_NOTIFICATION_EMAILS=

# --- AI (optional) ---
#
# Without this, AI plan generation falls back to a non-AI structured
# template (see server/services/aiService.ts) — the app still works.

OPENAI_API_KEY=

# --- GitHub integration (optional, configured per-company in-app) ---
#
# The GitHub integration (commit/PR visibility on projects) is configured
# per-company from the admin dashboard, not via environment variables —
# nothing to set here.

# --- Server ---

# Port the Express server listens on.
PORT=3001
