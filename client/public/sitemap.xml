<?xml version="1.0" encoding="UTF-8"?>
<!--
  Replace APP_DOMAIN below with the real production domain before
  submitting this to Search Console — it's a placeholder, matching the
  APP_DOMAIN convention used throughout this repo's docs and .env.example.

  Company-specific public application pages (/apply/:slug) aren't listed
  here since their slugs don't exist until a company signs up — they're
  still crawlable via normal link discovery, just not enumerated statically.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://APP_DOMAIN/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://APP_DOMAIN/signup</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://APP_DOMAIN/manager-login</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://APP_DOMAIN/intern-login</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://APP_DOMAIN/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  <url>
    <loc>https://APP_DOMAIN/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  <url>
    <loc>https://APP_DOMAIN/contact</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
