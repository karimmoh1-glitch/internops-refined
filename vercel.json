{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run db:migrate",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/public/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/i/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|favicon|apple-touch-icon|opengraph|hero-abstract|robots.txt|sitemap.xml|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/morning-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/alumni",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/shifts",
      "schedule": "30 14 * * *"
    }
  ]
}
